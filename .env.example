# Local development only. Keep HOST on loopback; this build has no user login.
APP_ENV=development
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
SECRET_KEY=
MAX_CONTENT_LENGTH=10485760

# Optional VirusTotal v3 API key. Keep this value private.
VIRUSTOTAL_API_KEY=

# Optional SQLAlchemy URL. Empty uses local SQLite at data/phishtrace.db.
DATABASE_URL=
